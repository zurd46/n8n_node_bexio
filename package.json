{
  "name": "@zurdai/n8n-nodes-bexio",
  "version": "1.3.0",
  "description": "n8n node for Bexio API integration",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "bexio",
    "accounting",
    "crm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/zurd46/n8n_node_bexio",
  "author": {
    "name": "Daniel Zurmühle",
    "email": "dzurmuehle@gmail.com",
    "url": "https://impulsai.ch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zurd46/n8n_node_bexio.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "format": "prettier nodes credentials --write",
    "test": "tsx --test test/*.test.cts"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/BexioApi.credentials.js",
      "dist/credentials/BexioOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Bexio/Bexio.node.js",
      "dist/nodes/Bexio/BexioTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.56.1",
    "eslint": "^9.39.4",
    "n8n-workflow": "^1.117.0",
    "prettier": "^3.8.3",
    "release-it": "^20.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
